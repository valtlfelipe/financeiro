{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check resources/js resources/css public/service-worker.js scripts/check-translations.mjs tests/js",
        "check:fix": "vp check --fix resources/js resources/css public/service-worker.js scripts/check-translations.mjs tests/js",
        "types:check": "vue-tsc --noEmit",
        "i18n:check": "node scripts/check-translations.mjs",
        "test:unit": "node --experimental-strip-types --test tests/js/*.mjs",
        "ci": "npm run check && npm run types:check && npm run test:unit && npm run i18n:check && npm run build"
    },
    "dependencies": {
        "@dicebear/core": "10.7.0",
        "@dicebear/styles": "10.6.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@inertiajs/vite": "^3.7.0",
        "@inertiajs/vue3": "^3.7.0",
        "@laravel/passkeys": "^0.4.0",
        "@lucide/vue": "^1.39.0",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.2.2",
        "vite-plus": "0.3.0",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
